# Bu dosyayı .env olarak kopyala ve kendi değerlerini gir.
# .env asla git'e commit edilmemeli (.gitignore'da zaten hariç tutuldu).

# --- AI (Anthropic Claude) ---
# https://console.anthropic.com/ adresinden alabilirsin. Boş bırakırsan sistem
# otomatik olarak anahtar kelime tabanlı (deterministik) skorlama ve şablon
# e-posta üretimine düşer — uygulama yine de çalışır, sadece AI destekli olmaz.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- E-posta gönderimi (Gmail App Password) ---
# 1) Google hesabında 2FA açık olmalı.
# 2) https://myaccount.google.com/apppasswords adresinden bir "App Password" oluştur.
# 3) Normal Gmail şifreni DEĞİL, oluşturduğun 16 haneli app password'ü kullan.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Anti-spam / güvenlik ---
# Günde en fazla kaç başvuru gönderilebileceğinin sert sınırı.
MAX_DAILY_SENDS=15
